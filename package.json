{
  "name": "desktop-speak-text",
  "version": "1.0.0",
  "description": "An Electron application with React and TypeScript",
  "main": "./out/main/index.js",
  "author": "hocgin",
  "homepage": "https://github.com/hocgin/electron-starter",
  "type": "module",
  "node": ">=18",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "cross-env NODE_ENV=production electron-vite preview",
    "dev": "cross-env NODE_ENV=development electron-vite dev -- --trace-warnings --watch",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "db:migrate-local": "drizzle-kit generate",
    "test:ai": "tsx --test tests/ai/*.test.ts"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^4.0.0",
    "@panva/hkdf": "^1.2.1",
    "@xterm/xterm": "^6.0.0",
    "axios": "^1.12.1",
    "better-sqlite3": "^11.10.0",
    "class-variance-authority": "^0.7.1",
    "cross-fetch": "^4.1.0",
    "drizzle-orm": "^0.42.0",
    "electron-router-dom": "^2.1.0",
    "electron-store": "^10.0.1",
    "electron-updater": "^6.3.9",
    "https-proxy-agent": "^7.0.6",
    "i18next": "^25.1.3",
    "i18next-electron-fs-backend": "^3.0.3",
    "i18next-fs-backend": "^2.6.0",
    "isomorphic-ws": "^5.0.0",
    "jose": "^6.0.11",
    "lodash": "^4.17.21",
    "menubar": "^9.5.1",
    "radix-ui": "^1.8.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^15.5.1",
    "react-router-dom": "^7.6.0",
    "react-xtermjs": "^1.0.10",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tar": "^7.5.1",
    "uuid": "^11.1.0",
    "ws": "^8.18.3",
    "xml-escape": "^1.1.0",
    "yauzl": "^3.2.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.0.0",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.14.1",
    "@types/react": "^19.1.1",
    "@types/react-dom": "^19.1.2",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^4.3.4",
    "ahooks": "^3.8.4",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.1",
    "electron": "^35.1.4",
    "electron-builder": "^26.0.12",
    "electron-vite": "^3.1.0",
    "eslint": "^9.24.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "lucide-react": "^0.510.0",
    "memoize-one": "^6.0.0",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.8.3",
    "vite": "^6.2.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "esbuild"
    ]
  },
  "packageManager": "pnpm@8.15.4+sha512.0bd3a9be9eb0e9a692676deec00a303ba218ba279d99241475616b398dbaeedd11146f92c2843458f557b1d127e09d4c171e105bdcd6b61002b39685a8016b9e"
}
